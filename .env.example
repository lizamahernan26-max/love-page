# 本机开发。复制为 .env 后可按需修改，不要提交真实 .env。
PORT=8790
XINWANG_HOST=127.0.0.1
# XINWANG_DB_PATH=/absolute/private/path/xinwang.sqlite
# 正式部署时必须配置以下三项，并通过 HTTPS 反向代理访问：
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# XINWANG_TRUST_PROXY=loopback
# 空白正式数据库可设置至少 32 字符的初始化密钥；首个账号创建后不再使用。
# XINWANG_SETUP_KEY=

# Render + Neon 免费部署：通过平台环境变量填写，不能放进 HTML 或 GitHub。
# DATABASE_URL=（从 Neon 连接面板取得，不要提交真实值）
# 运行 npm run start:cloud；它使用 Render 自动提供的 HTTPS 地址。
